<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter. Kept intentionally minimal — every entry below is a specific,
  investigated finding with a documented reason it isn't a real defect here, not a blanket
  category suppression. Never add an entry to silence a real finding without investigating it
  first.
-->
<FindBugsFilter>
    <!--
      EI_EXPOSE_REP2 on TenantAdminNotifier(UserRepository, NotificationService): flags storing
      the injected UserRepository reference into a field. This is plain constructor injection of
      a stateless platform repository interface — the same pattern GuardianService uses for its
      EventPublisher field (also a platform interface) without SpotBugs flagging it. Investigated
      2026-08-16: no other structurally identical constructor in this module is flagged, so this
      is detector noise on a standard, safe DI pattern, not a real defect — there is no mutable
      state to leak, and the reference is never handed back to a caller.
    -->
    <Match>
        <Class name="com.altafjava.school.application.scheduler.support.TenantAdminNotifier"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!--
      EI_EXPOSE_REP2 on ReportCardService's 10-arg constructor: flags storing the injected
      StorageService (a platform interface) and ReportCardPdfGenerator (a stateless, school-local
      formatting component) references into fields. Same standard constructor-injection pattern
      as every other service in this module — investigated 2026-08-16, alongside the
      TenantAdminNotifier finding above: this detector flags EI_EXPOSE_REP2 inconsistently across
      structurally identical constructors (interface-typed and concrete-typed alike) elsewhere in
      this exact module, which is detector noise, not a real defect — neither field holds mutable
      state that could leak, and neither is ever handed back to a caller.
    -->
    <Match>
        <Class name="com.altafjava.school.application.service.ReportCardService"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!--
      EI_EXPOSE_REP2 on OrganizationRollupService's 5-arg constructor: flags storing the injected
      OrganizationService (platform application-layer service) and the four school repository
      interfaces into fields. Same standard constructor-injection pattern as
      TenantAdminNotifier/ReportCardService above — investigated 2026-08-17: none of these fields
      hold mutable state that could leak, and none is ever handed back to a caller. Consistent
      detector noise on ordinary DI, not a real defect.
    -->
    <Match>
        <Class name="com.altafjava.school.application.rollup.OrganizationRollupService"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
