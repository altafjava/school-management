<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Additive + backfill + guarded not-null, same discipline as school-020/021/022
         (classrooms.academic_year_id). Every existing exam predates status tracking; there is no
         signal to tell which already happened, so SCHEDULED — the safe, non-committal default — is
         used for every historical row. -->
    <changeSet id="school-055-exam-status" author="school">
        <addColumn tableName="exams">
            <column name="status" type="VARCHAR(20)"/>
        </addColumn>
    </changeSet>

    <changeSet id="school-056-exam-status-backfill" author="school">
        <sql>
            UPDATE exams SET status = 'SCHEDULED' WHERE deleted = false AND status IS NULL
        </sql>
    </changeSet>

    <changeSet id="school-057-exam-status-not-null" author="school">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM exams WHERE deleted = false AND status IS NULL
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="exams" columnName="status" columnDataType="VARCHAR(20)"/>
    </changeSet>

    <!-- Same discipline for exam_type. No existing signal distinguishes UNIT_TEST/MIDTERM/FINAL/QUIZ
         for historical rows, so every pre-existing exam backfills to UNIT_TEST — the lowest-stakes,
         most generic category — rather than inventing a false classification. -->
    <changeSet id="school-058-exam-type" author="school">
        <addColumn tableName="exams">
            <column name="exam_type" type="VARCHAR(20)"/>
        </addColumn>
    </changeSet>

    <changeSet id="school-059-exam-type-backfill" author="school">
        <sql>
            UPDATE exams SET exam_type = 'UNIT_TEST' WHERE deleted = false AND exam_type IS NULL
        </sql>
    </changeSet>

    <changeSet id="school-060-exam-type-not-null" author="school">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM exams WHERE deleted = false AND exam_type IS NULL
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="exams" columnName="exam_type" columnDataType="VARCHAR(20)"/>
    </changeSet>

</databaseChangeLog>
