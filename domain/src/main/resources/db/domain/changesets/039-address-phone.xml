<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Structured, region-agnostic address (Address.java) and validated phone capture for
         Student/Teacher/Guardian. Every column is nullable — an address/phone is optional for
         every one of these entities, and address_region specifically stays optional even when
         the rest of an address is filled in, since many countries have no state/province concept. -->

    <changeSet id="school-086-student-phone-address" author="school">
        <addColumn tableName="students">
            <column name="phone" type="VARCHAR(30)"/>
            <column name="address_line1" type="VARCHAR(255)"/>
            <column name="address_line2" type="VARCHAR(255)"/>
            <column name="address_locality" type="VARCHAR(100)"/>
            <column name="address_region" type="VARCHAR(100)"/>
            <column name="address_postal_code" type="VARCHAR(20)"/>
            <column name="address_country_code" type="VARCHAR(2)"/>
        </addColumn>
    </changeSet>

    <changeSet id="school-087-teacher-phone-address" author="school">
        <addColumn tableName="teachers">
            <column name="phone" type="VARCHAR(30)"/>
            <column name="address_line1" type="VARCHAR(255)"/>
            <column name="address_line2" type="VARCHAR(255)"/>
            <column name="address_locality" type="VARCHAR(100)"/>
            <column name="address_region" type="VARCHAR(100)"/>
            <column name="address_postal_code" type="VARCHAR(20)"/>
            <column name="address_country_code" type="VARCHAR(2)"/>
        </addColumn>
    </changeSet>

    <changeSet id="school-088-guardian-address" author="school">
        <!-- guardians.phone already exists (see 001-school-tables.xml) — only address is new here. -->
        <addColumn tableName="guardians">
            <column name="address_line1" type="VARCHAR(255)"/>
            <column name="address_line2" type="VARCHAR(255)"/>
            <column name="address_locality" type="VARCHAR(100)"/>
            <column name="address_region" type="VARCHAR(100)"/>
            <column name="address_postal_code" type="VARCHAR(20)"/>
            <column name="address_country_code" type="VARCHAR(2)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
