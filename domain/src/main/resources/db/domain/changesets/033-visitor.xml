<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-077-visitor-logs" author="school">
        <createTable tableName="visitor_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="visitor_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="visitor_phone" type="VARCHAR(50)"/>
            <column name="purpose" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="host_teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="check_in_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="check_out_at" type="TIMESTAMP"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_visitor_logs_tenant_id"
                baseTableName="visitor_logs" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_visitor_logs_host_teacher_id"
                baseTableName="visitor_logs" baseColumnNames="host_teacher_id"
                referencedTableName="teachers" referencedColumnNames="id"/>

        <createIndex indexName="idx_visitor_logs_tenant_id" tableName="visitor_logs">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_visitor_logs_deleted" tableName="visitor_logs">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_visitor_logs_host_teacher_id" tableName="visitor_logs">
            <column name="host_teacher_id"/>
        </createIndex>
        <createIndex indexName="idx_visitor_logs_check_in_at" tableName="visitor_logs">
            <column name="check_in_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
