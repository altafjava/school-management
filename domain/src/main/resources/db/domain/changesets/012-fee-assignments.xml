<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-024-fee-assignments" author="school">
        <createTable tableName="fee_assignments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fee_structure_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="scope" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <!-- Exactly one of student_id / classroom_id is set, matching `scope' — enforced by FeeAssignment.forStudent/forClassroom. -->
            <column name="student_id" type="BIGINT"/>
            <column name="classroom_id" type="BIGINT"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_fa_tenant_id"
                baseTableName="fee_assignments" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_fa_fee_structure_id"
                baseTableName="fee_assignments" baseColumnNames="fee_structure_id"
                referencedTableName="fee_structures" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_fa_student_id"
                baseTableName="fee_assignments" baseColumnNames="student_id"
                referencedTableName="students" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_fa_classroom_id"
                baseTableName="fee_assignments" baseColumnNames="classroom_id"
                referencedTableName="classrooms" referencedColumnNames="id"/>

        <createIndex indexName="idx_fa_tenant_id" tableName="fee_assignments">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_fa_deleted" tableName="fee_assignments">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_fa_fee_structure_id" tableName="fee_assignments">
            <column name="fee_structure_id"/>
        </createIndex>
        <createIndex indexName="idx_fa_student_id" tableName="fee_assignments">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="idx_fa_classroom_id" tableName="fee_assignments">
            <column name="classroom_id"/>
        </createIndex>
        <createIndex indexName="uq_fa_fee_structure_student" tableName="fee_assignments" unique="true">
            <column name="fee_structure_id"/>
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="uq_fa_fee_structure_classroom" tableName="fee_assignments" unique="true">
            <column name="fee_structure_id"/>
            <column name="classroom_id"/>
        </createIndex>
    </changeSet>

    <!-- Preserves current behavior for tenants that already have fee structures + recorded
         payments: explicitly assign every existing FeeStructure to every currently-active
         Student, so no existing balance disappears the moment assignment-gated calculation
         ships. New fee structures created after this point require an explicit assignment. -->
    <changeSet id="school-025-fee-assignments-backfill" author="school">
        <sql>
            INSERT INTO fee_assignments
                (public_id, version, tenant_id, fee_structure_id, scope, student_id, classroom_id,
                 deleted, created_at, updated_at)
            SELECT UUID(), 0, fs.tenant_id, fs.id, 'STUDENT', s.id, NULL,
                   false, NOW(), NOW()
            FROM fee_structures fs
            JOIN students s ON s.tenant_id = fs.tenant_id AND s.deleted = false
            WHERE fs.deleted = false;
        </sql>
        <rollback>
            <sql>DELETE FROM fee_assignments WHERE scope = 'STUDENT';</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
