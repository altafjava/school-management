<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-026-admission-entrance-test-score" author="school">
        <addColumn tableName="admissions">
            <column name="entrance_test_score" type="DECIMAL(10,2)"/>
            <column name="entrance_test_max_score" type="DECIMAL(10,2)"/>
            <column name="merit_rank" type="INTEGER"/>
        </addColumn>
    </changeSet>

    <changeSet id="school-027-admission-merit-rank-index" author="school">
        <createIndex indexName="idx_admissions_merit_rank" tableName="admissions">
            <column name="merit_rank"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
