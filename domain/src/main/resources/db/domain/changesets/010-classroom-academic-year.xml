<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- classrooms.academic_year (free text) is being replaced by a real FK to academic_years.
         Additive + backfill + guarded not-null, per CLAUDE.md's "prod/staging: renames/drops are
         multi-release; never modify existing changesets" rule. The legacy academic_year column
         is intentionally kept for this release; dropping it is a separate, later changeset once
         every environment has applied school-022 cleanly. -->
    <changeSet id="school-020-classroom-academic-year-id" author="school">
        <addColumn tableName="classrooms">
            <column name="academic_year_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                constraintName="fk_classrooms_academic_year_id"
                baseTableName="classrooms" baseColumnNames="academic_year_id"
                referencedTableName="academic_years" referencedColumnNames="id"/>

        <createIndex indexName="idx_classrooms_academic_year_id" tableName="classrooms">
            <column name="academic_year_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-021-classroom-academic-year-id-backfill" author="school">
        <sql>
            UPDATE classrooms c
            JOIN academic_years ay
              ON ay.tenant_id = c.tenant_id
             AND ay.name = c.academic_year
             AND ay.deleted = false
            SET c.academic_year_id = ay.id
            WHERE c.deleted = false AND c.academic_year_id IS NULL;
        </sql>
    </changeSet>

    <changeSet id="school-022-classroom-academic-year-id-not-null" author="school">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM classrooms WHERE deleted = false AND academic_year_id IS NULL
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="classrooms" columnName="academic_year_id" columnDataType="BIGINT"/>
    </changeSet>

</databaseChangeLog>
