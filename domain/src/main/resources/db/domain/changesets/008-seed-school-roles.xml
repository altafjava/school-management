<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Global system-role templates (tenant_id = NULL), like platform-saas's TENANT_ADMIN — see Role.java. -->
    <changeSet id="school-018-seed-school-roles" author="school">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM roles WHERE name = 'TEACHER' AND tenant_id IS NULL</sqlCheck>
        </preConditions>
        <insert tableName="roles">
            <column name="name" value="TEACHER"/>
            <column name="description" value="Class management, student grades, attendance"/>
            <column name="is_system_role" valueBoolean="true"/>
            <column name="permissions_json" value='["ACADEMIC_YEAR_READ", "ASSIGNMENT_READ", "ASSIGNMENT_WRITE", "BOARD_READ", "BOOK_READ", "CLASSROOM_READ", "CURRICULUM_READ", "CUSTOM_FIELD_VALUE_READ", "DISCIPLINE_ACTION", "DISCIPLINE_READ", "DISCIPLINE_WRITE", "EVENT_READ", "EVENT_STAFF_MANAGE", "EXAM_COMPLETE", "GRADING_SCALE_READ", "HOLIDAY_READ", "HOSTEL_READ", "LEAVE_SELF_SERVICE", "LEAVE_TYPE_READ", "LESSON_READ", "LESSON_WRITE", "PERIOD_ATTENDANCE_MANAGE", "PERIOD_READ", "REPORT_CARD_TEMPLATE_READ", "ROOM_ALLOCATION_READ", "ROOM_READ", "STUDENT_ATTENDANCE_READ", "STUDENT_ATTENDANCE_WRITE", "STUDENT_GRADES_READ", "STUDENT_GRADES_WRITE", "STUDENT_READ", "STUDENT_SELF_SERVICE_READ", "SUBJECT_READ", "SUBMISSION_GRADE", "SUBMISSION_READ", "TERM_READ", "TICKET_MANAGE", "TICKET_SELF_SERVICE", "TIMETABLE_READ", "TRANSPORT_ASSIGNMENT_READ", "TRANSPORT_ROUTE_READ", "VEHICLE_READ", "VISITOR_LOG_MANAGE"]'/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" valueDate="NOW()"/>
        </insert>

        <insert tableName="roles">
            <column name="name" value="STUDENT"/>
            <column name="description" value="View own grades, attendance, timetable"/>
            <column name="is_system_role" valueBoolean="true"/>
            <column name="permissions_json" value='["ASSIGNMENT_READ", "BOOK_READ", "CLASSROOM_READ", "DISCIPLINE_READ", "EVENT_READ", "EVENT_REGISTER", "FEE_PAYMENT_SELF_SERVICE", "LESSON_READ", "STUDENT_ATTENDANCE_READ", "STUDENT_FEE_BALANCE_READ", "STUDENT_GRADES_READ", "STUDENT_SELF_SERVICE_READ", "SUBMISSION_SUBMIT", "TICKET_SELF_SERVICE"]'/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" valueDate="NOW()"/>
        </insert>

        <insert tableName="roles">
            <column name="name" value="PARENT"/>
            <column name="description" value="View linked children's grades, attendance, fees"/>
            <column name="is_system_role" valueBoolean="true"/>
            <column name="permissions_json" value='["ASSIGNMENT_READ", "BOOK_READ", "DISCIPLINE_READ", "EVENT_READ", "EVENT_REGISTER", "FEE_PAYMENT_SELF_SERVICE", "GUARDIAN_CONSENT_MANAGE", "GUARDIAN_SELF_SERVICE", "LESSON_READ", "STUDENT_ATTENDANCE_READ", "STUDENT_FEE_BALANCE_READ", "STUDENT_GRADES_READ", "STUDENT_SELF_SERVICE_READ", "TICKET_SELF_SERVICE"]'/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_at" valueDate="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
