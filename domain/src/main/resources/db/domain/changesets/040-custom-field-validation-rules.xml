<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Turns custom_field_definitions from a bare type/label store into a real configurable-field
         system: a validation rule (min/max for NUMBER, regex for TEXT, options for the new
         SELECT/MULTI_SELECT field types) plus display ordering/grouping for a frontend form
         builder. Every column is nullable/defaulted — existing definitions keep working unchanged. -->
    <changeSet id="school-089-custom-field-validation-rules" author="school">
        <addColumn tableName="custom_field_definitions">
            <column name="min_value" type="DECIMAL(19,4)"/>
            <column name="max_value" type="DECIMAL(19,4)"/>
            <column name="regex_pattern" type="VARCHAR(500)"/>
            <column name="options" type="VARCHAR(2000)"/>
            <column name="display_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="display_group" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
