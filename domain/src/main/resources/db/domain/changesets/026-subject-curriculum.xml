<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Same nullable FK-as-plain-Long convention as school-041 (classrooms.curriculum_id): not
         every subject is tied to a curriculum, so no backfill or not-null constraint is needed. -->
    <changeSet id="school-064-subject-curriculum" author="school">
        <addColumn tableName="subjects">
            <column name="curriculum_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                constraintName="fk_subjects_curriculum_id"
                baseTableName="subjects" baseColumnNames="curriculum_id"
                referencedTableName="curricula" referencedColumnNames="id"/>
        <createIndex indexName="idx_subjects_curriculum_id" tableName="subjects">
            <column name="curriculum_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
