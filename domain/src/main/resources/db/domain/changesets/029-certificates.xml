<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-069-certificate-templates" author="school">
        <createTable tableName="certificate_templates">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="body_template" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_certificate_templates_tenant_id"
                baseTableName="certificate_templates" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>

        <createIndex indexName="idx_certificate_templates_tenant_id" tableName="certificate_templates">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_certificate_templates_deleted" tableName="certificate_templates">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_certificate_templates_active" tableName="certificate_templates">
            <column name="active"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-070-certificate-issuances" author="school">
        <createTable tableName="certificate_issuances">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="certificate_template_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="issued_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="verification_code" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="storage_key" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <!-- FK to platform users.id — deliberately no addForeignKeyConstraint, matching
                 leave_requests.approved_by_user_id's precedent for "who performed this action"
                 audit columns (as opposed to teachers/students/guardians.user_id's "this person's
                 own linked login" FK, which does get a constraint). -->
            <column name="issued_by_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_certificate_issuances_tenant_id"
                baseTableName="certificate_issuances" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_certificate_issuances_student_id"
                baseTableName="certificate_issuances" baseColumnNames="student_id"
                referencedTableName="students" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_certificate_issuances_template_id"
                baseTableName="certificate_issuances" baseColumnNames="certificate_template_id"
                referencedTableName="certificate_templates" referencedColumnNames="id"/>

        <createIndex indexName="idx_certificate_issuances_tenant_id" tableName="certificate_issuances">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_certificate_issuances_deleted" tableName="certificate_issuances">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_certificate_issuances_student_id" tableName="certificate_issuances">
            <column name="student_id"/>
        </createIndex>
        <createIndex indexName="uq_certificate_issuances_verification_code" tableName="certificate_issuances"
                     unique="true">
            <column name="tenant_id"/>
            <column name="verification_code"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
