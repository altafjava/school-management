<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-019-exam-term-id" author="school">
        <addColumn tableName="exams">
            <column name="term_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                constraintName="fk_exams_term_id"
                baseTableName="exams" baseColumnNames="term_id"
                referencedTableName="terms" referencedColumnNames="id"/>

        <createIndex indexName="idx_exams_term_id" tableName="exams">
            <column name="term_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
