<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Closes the two gaps found in the custom-field engine: displayGroup itself had no order
         (only fields within a flat list did), and there was no conditional-visibility concept at
         all. Both are now interpreted server-side by CustomFieldValueService#getGroupedValues,
         unlike displayOrder/displayGroup which remain opaque rendering hints. -->
    <changeSet id="school-047-custom-field-grouping-visibility" author="school">
        <addColumn tableName="custom_field_definitions">
            <column name="display_group_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="visibility_depends_on_field_key" type="VARCHAR(100)"/>
            <column name="visibility_operator" type="VARCHAR(20)"/>
            <column name="visibility_expected_value" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
