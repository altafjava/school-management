<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Terms gain an explicit is_current flag, mirroring academic_years.is_current, replacing the
         date-range-math "current term" lookup with the same explicit-flag idiom (flipped going
         forward by TermRolloverJob). Additive + backfill + guarded not-null, same discipline as
         school-020/021/022 (classrooms.academic_year_id): every existing term is backfilled here —
         true for whichever term's range contains today at migration time (mirroring how
         classrooms.academic_year_id was backfilled by name-match), false for every other term. -->
    <changeSet id="school-061-term-current" author="school">
        <addColumn tableName="terms">
            <column name="is_current" type="BOOLEAN"/>
        </addColumn>
    </changeSet>

    <changeSet id="school-062-term-current-backfill" author="school">
        <sql>
            UPDATE terms SET is_current = true
            WHERE deleted = false AND CURDATE() BETWEEN start_date AND end_date
        </sql>
        <sql>
            UPDATE terms SET is_current = false WHERE is_current IS NULL
        </sql>
    </changeSet>

    <changeSet id="school-063-term-current-not-null" author="school">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM terms WHERE is_current IS NULL
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="terms" columnName="is_current" columnDataType="BOOLEAN"/>
    </changeSet>

</databaseChangeLog>
