<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Leave carry-forward policy (LeaveType) and per-balance tracking (LeaveBalance), plus a
         teacher probation-period field consumed by LeaveType.availableDuringProbation. -->
    <changeSet id="school-092-leave-carry-forward-probation" author="school">
        <addColumn tableName="leave_types">
            <column name="available_during_probation" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="carry_forward_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="max_carry_forward_days" type="DECIMAL(5,1)"/>
            <column name="carry_forward_expiry_months" type="INT"/>
        </addColumn>

        <addColumn tableName="leave_balances">
            <column name="carried_forward_days" type="DECIMAL(5,1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="carry_forward_expires_at" type="DATE"/>
        </addColumn>

        <addColumn tableName="teachers">
            <column name="probation_end_date" type="DATE"/>
        </addColumn>

        <createIndex indexName="idx_leave_balances_carry_forward_expires_at" tableName="leave_balances">
            <column name="tenant_id"/>
            <column name="carry_forward_expires_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
