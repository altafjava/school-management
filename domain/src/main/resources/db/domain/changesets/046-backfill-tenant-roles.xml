<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- One-time backfill for tenants that existed before per-tenant editable roles: gives every
         already-provisioned tenant its own copy of each global system-role template (tenant_id IS
         NULL — platform's TENANT_ADMIN plus school-saas's TEACHER/STUDENT/PARENT/PRINCIPAL/
         FINANCE/HR/ACADEMIC), the same copy RoleProvisioningListener (platform-saas) now gives
         every newly-created tenant. Deliberately placed last in this changelog, not in
         platform-saas's own, so it runs only after every role template — platform's and this
         domain's own — has already been seeded. Generic by construction (copies whatever
         tenant_id IS NULL rows exist at run time), so it stays correct even if more are added
         later; safe to re-run (skips a tenant/role pair that already has its own copy). -->
    <changeSet id="school-046-backfill-tenant-roles" author="school">
        <!-- public_id and version are omitted deliberately, matching 008-seed-school-roles.xml's
             own <insert> — the roles table's own column defaults (uuid()/0, from
             002-roles-permissions.xml) fill them in; a raw SQL INSERT honors a column DEFAULT
             clause exactly like Liquibase's <insert> tag does. -->
        <sql>
            INSERT INTO roles (tenant_id, name, description, is_system_role, permissions_json, created_at)
            SELECT t.id, r.name, r.description, false, r.permissions_json, NOW()
            FROM tenants t
            CROSS JOIN roles r
            WHERE r.tenant_id IS NULL
              AND NOT EXISTS (
                SELECT 1 FROM roles r2 WHERE r2.tenant_id = t.id AND r2.name = r.name
              );
        </sql>
    </changeSet>

</databaseChangeLog>
