<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Additive: payment_source defaults to MANUAL so every existing fee_payments row and the
         existing FeePaymentService.record(...) flow are unaffected. gateway_provider_type /
         gateway_charge_reference stay null for manual payments — MariaDB permits multiple NULLs
         in a unique index, so the uniqueness constraint below only ever applies to gateway-sourced
         payments. -->
    <changeSet id="school-031-fee-payment-gateway" author="school">
        <addColumn tableName="fee_payments">
            <column name="payment_source" type="VARCHAR(20)" defaultValue="MANUAL">
                <constraints nullable="false"/>
            </column>
            <column name="gateway_provider_type" type="VARCHAR(50)"/>
            <column name="gateway_charge_reference" type="VARCHAR(255)"/>
        </addColumn>

        <createIndex indexName="uq_fee_payments_tenant_gateway_ref" tableName="fee_payments" unique="true">
            <column name="tenant_id"/>
            <column name="gateway_charge_reference"/>
        </createIndex>

        <createIndex indexName="idx_fee_payments_gateway_charge_reference" tableName="fee_payments">
            <column name="gateway_charge_reference"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
