<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Nullable: every classroom that existed before this column was added has no configured
         capacity, and null means "unlimited" rather than a guessed value — see Classroom.java. -->
    <changeSet id="school-082-classroom-capacity" author="school">
        <addColumn tableName="classrooms">
            <column name="capacity" type="INT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
