<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Due-date/grace-days/late-fee-percentage on FeeStructure (tenant-wide default) and
         FeeAssignment (per-assignment override) — see FeeBalanceCalculator's fallback chain. -->
    <changeSet id="school-093-fee-late-fee-policy" author="school">
        <addColumn tableName="fee_structures">
            <column name="grace_days" type="INT"/>
            <column name="late_fee_percentage" type="DECIMAL(5,2)"/>
        </addColumn>
        <addColumn tableName="fee_assignments">
            <column name="due_date" type="DATE"/>
            <column name="grace_days" type="INT"/>
            <column name="late_fee_percentage" type="DECIMAL(5,2)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
