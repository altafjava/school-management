<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="school-032-departments" author="school">
        <createTable tableName="departments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="head_teacher_id" type="BIGINT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_departments_tenant_id"
                baseTableName="departments" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_departments_head_teacher_id"
                baseTableName="departments" baseColumnNames="head_teacher_id"
                referencedTableName="teachers" referencedColumnNames="id"/>

        <createIndex indexName="idx_departments_tenant_id" tableName="departments">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_departments_deleted" tableName="departments">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_departments_head_teacher_id" tableName="departments">
            <column name="head_teacher_id"/>
        </createIndex>
        <createIndex indexName="uq_departments_tenant_code" tableName="departments" unique="true">
            <column name="tenant_id"/>
            <column name="code"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-033-teachers-hr-details" author="school">
        <addColumn tableName="teachers">
            <column name="department_id" type="BIGINT"/>
            <column name="qualification" type="VARCHAR(255)"/>
            <column name="employment_type" type="VARCHAR(30)"/>
        </addColumn>
        <addForeignKeyConstraint
                constraintName="fk_teachers_department_id"
                baseTableName="teachers" baseColumnNames="department_id"
                referencedTableName="departments" referencedColumnNames="id"/>
        <createIndex indexName="idx_teachers_department_id" tableName="teachers">
            <column name="department_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-034-leave-types" author="school">
        <createTable tableName="leave_types">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="default_annual_days" type="DECIMAL(5,1)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_leave_types_tenant_id"
                baseTableName="leave_types" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>

        <createIndex indexName="idx_leave_types_tenant_id" tableName="leave_types">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_types_deleted" tableName="leave_types">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="uq_leave_types_tenant_name" tableName="leave_types" unique="true">
            <column name="tenant_id"/>
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-035-leave-balances" author="school">
        <createTable tableName="leave_balances">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="leave_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="academic_year_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="allocated_days" type="DECIMAL(5,1)">
                <constraints nullable="false"/>
            </column>
            <column name="used_days" type="DECIMAL(5,1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_leave_balances_tenant_id"
                baseTableName="leave_balances" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_leave_balances_teacher_id"
                baseTableName="leave_balances" baseColumnNames="teacher_id"
                referencedTableName="teachers" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_leave_balances_leave_type_id"
                baseTableName="leave_balances" baseColumnNames="leave_type_id"
                referencedTableName="leave_types" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_leave_balances_academic_year_id"
                baseTableName="leave_balances" baseColumnNames="academic_year_id"
                referencedTableName="academic_years" referencedColumnNames="id"/>

        <createIndex indexName="idx_leave_balances_tenant_id" tableName="leave_balances">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_balances_deleted" tableName="leave_balances">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_leave_balances_teacher_id" tableName="leave_balances">
            <column name="teacher_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_balances_leave_type_id" tableName="leave_balances">
            <column name="leave_type_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_balances_academic_year_id" tableName="leave_balances">
            <column name="academic_year_id"/>
        </createIndex>
        <createIndex indexName="uq_leave_balances_teacher_type_year" tableName="leave_balances" unique="true">
            <column name="teacher_id"/>
            <column name="leave_type_id"/>
            <column name="academic_year_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="school-036-leave-requests" author="school">
        <createTable tableName="leave_requests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="teacher_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="leave_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="academic_year_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="days_requested" type="DECIMAL(5,1)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="approved_by_user_id" type="BIGINT"/>
            <column name="approved_at" type="TIMESTAMP"/>
            <column name="rejection_reason" type="VARCHAR(500)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_leave_requests_tenant_id"
                baseTableName="leave_requests" baseColumnNames="tenant_id"
                referencedTableName="tenants" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_leave_requests_teacher_id"
                baseTableName="leave_requests" baseColumnNames="teacher_id"
                referencedTableName="teachers" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_leave_requests_leave_type_id"
                baseTableName="leave_requests" baseColumnNames="leave_type_id"
                referencedTableName="leave_types" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_leave_requests_academic_year_id"
                baseTableName="leave_requests" baseColumnNames="academic_year_id"
                referencedTableName="academic_years" referencedColumnNames="id"/>

        <createIndex indexName="idx_leave_requests_tenant_id" tableName="leave_requests">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_requests_deleted" tableName="leave_requests">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_leave_requests_teacher_id" tableName="leave_requests">
            <column name="teacher_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_requests_leave_type_id" tableName="leave_requests">
            <column name="leave_type_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_requests_academic_year_id" tableName="leave_requests">
            <column name="academic_year_id"/>
        </createIndex>
        <createIndex indexName="idx_leave_requests_status" tableName="leave_requests">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
